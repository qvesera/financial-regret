{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "outputDirectory": "public",

  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,public/**,scripts/**,*.md}"
    }
  },

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
