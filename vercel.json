{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "outputDirectory": "public",

  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,public/**,scripts/**,*.md}"
    }
  },

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-cache" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://is.gd; img-src 'self' data: https://cdn2.steamgriddb.com https://cdn.steamgriddb.com; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
